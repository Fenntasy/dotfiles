op_load() {
    local file="${1:-secrets.env}"

    command -v op >/dev/null || { echo "op (1Password CLI) not installed" >&2; return 1; }
    [[ -r "$file" ]] || { echo "op_load: cannot read $file" >&2; return 1; }
    if ! op whoami >/dev/null 2>&1; then
        local session
        session=$(op signin) || { echo "op_load: sign-in failed" >&2; return 1; }
        eval "$session"
    fi

    # Capture first so a failed op inject doesn't leave half-loaded env
    local resolved
    resolved=$(op inject -i "$file") || return $?
    # Parse assignments instead of eval/source: op inject substitutes vault
    # values verbatim, so evaluating them as shell code would let a value
    # containing $(...) or backticks execute in this shell.
    setopt localoptions extendedglob
    local line key value
    for line in ${(f)resolved}; do
        [[ "$line" == [[:space:]]#(\#*|) ]] && continue
        line="${line##[[:space:]]#}"
        line="${line#export[[:space:]]##}"
        key="${line%%=*}"
        value="${line#*=}"
        if [[ "$key" != [A-Za-z_][A-Za-z0-9_]# || "$line" != *=* ]]; then
            echo "op_load: skipping malformed line: ${line%%=*}" >&2
            continue
        fi
        # Strip one pair of matching surrounding quotes, as dotenv files do
        if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
            value="${value[2,-2]}"
        fi
        export "$key"="$value"
    done
}
