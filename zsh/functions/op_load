op_load() {
    local file="${1:-secrets.env}"

    command -v op >/dev/null || { echo "op_load: op (1Password CLI) not installed" >&2; return 1; }
    [[ -r "$file" ]] || { echo "op_load: cannot read $file" >&2; return 1; }
    if ! op whoami >/dev/null 2>&1; then
        local session
        session=$(op signin) || { echo "op_load: sign-in failed" >&2; return 1; }
        eval "$session"
    fi

    # Resolve each reference with `op read` rather than evaluating `op inject`
    # output: only the template we wrote is ever parsed, so resolved values
    # can't smuggle in shell code or extra assignments, and multi-line
    # secrets survive intact. Template lines must be KEY=op://ref (an
    # `export ` prefix and quotes around the ref are tolerated).
    setopt localoptions extendedglob
    local line key ref value
    local -i lineno=0
    local -a keys values
    while IFS= read -r line || [[ -n "$line" ]]; do
        (( lineno++ ))
        [[ "$line" == [[:space:]]#(\#*|) ]] && continue
        line="${line##[[:space:]]#}"
        line="${line#export[[:space:]]##}"
        key="${line%%=*}"
        ref="${line#*=}"
        if [[ "$ref" == \"*\" || "$ref" == \'*\' ]]; then
            ref="${ref[2,-2]}"
        fi
        # Only a line number in the warning — echoing content could print
        # secret material to stderr.
        if [[ "$line" != *=* || "$key" != [A-Za-z_][A-Za-z0-9_]# || "$ref" != op://* ]]; then
            echo "op_load: skipping malformed line $lineno (expected KEY=op://ref)" >&2
            continue
        fi
        # Resolve everything before exporting anything, so a failed read
        # doesn't leave a half-loaded environment.
        value=$(op read "$ref") || { echo "op_load: failed to resolve line $lineno" >&2; return 1; }
        keys+=("$key")
        values+=("$value")
    done < "$file"

    local -i i
    for (( i = 1; i <= $#keys; i++ )); do
        export "${keys[i]}"="${values[i]}"
    done
}
