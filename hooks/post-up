#!/bin/bash

[[ "${SHELL}" != "/bin/zsh" ]] && chsh -s /bin/zsh

# Seed the settings baseline on new machines only — never overwrite, the real
# file accumulates machine-local values (OTel, credential helpers)
[[ -f "${HOME}/.claude/settings.json" ]] || { mkdir -p "${HOME}/.claude" && cp "$(dirname "$0")/../claude/settings.json" "${HOME}/.claude/settings.json"; }
