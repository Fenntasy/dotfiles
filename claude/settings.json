{
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/claude/mods/roborev-pane"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.notification_type // \"needs attention\"' | { read -r t; t=\"${t//\\\"/}\"; osascript -e \"display notification \\\"$t\\\" with title \\\"Claude Code\\\"\"; }",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright-skill@playwright-skill": true,
    "stripe@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "code-simplifier@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "playwright-skill": {
      "source": {
        "source": "github",
        "repo": "lackeyjb/playwright-skill"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "light",
  "agentPushNotifEnabled": true
}
