#!/usr/bin/env bash
# Poll roborev until no review is running or queued, then print the latest
# review. Replaces the ad-hoc `while true; do roborev list...` loops.
#
# Usage: roborev-wait [timeout_seconds]   (default 900)
set -euo pipefail

timeout="${1:-900}"
start="$(date +%s)"

while :; do
  out="$(roborev list 2>/dev/null || true)"
  if ! grep -qE '\b(running|queued)\b' <<<"$out"; then
    break
  fi
  if (( $(date +%s) - start > timeout )); then
    echo "roborev-wait: still running after ${timeout}s" >&2
    echo "$out" >&2
    exit 1
  fi
  sleep 10
done

job="$(roborev list 2>/dev/null | awk 'NR==2 {print $1}')"
if [[ -z "$job" ]]; then
  echo "roborev-wait: no reviews found for this branch" >&2
  exit 1
fi
roborev show "$job" --job
